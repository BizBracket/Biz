<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_view_form_inherit_biz" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit.biz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="branch_id"/>
            </xpath>

        </field>
    </record>

    <record id="view_partner_form_inherit_biz" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.biz</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_id']" position="before">
                <field name="city_id" placeholder="City"  context="{'country_id': country_id}"/>
                 <field name="pin_code" placeholder="ZIP"
                        context="{'country_id': country_id, 'city_id' : city_id}"
                 />
            </xpath>
            <xpath expr="//field[@name='state_id']" position="attributes">
                    <attribute name="context">{'country_id': country_id}</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                    <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='zip']" position="attributes">
                    <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_biz" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.biz</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="city_id" />
                <field name="pin_code" />
                <field name="branch_id"/>
            </xpath>

        </field>
    </record>

</odoo>